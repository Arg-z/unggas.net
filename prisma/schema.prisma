generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int          @id @default(autoincrement())
  username     String       @unique @db.VarChar(32)
  email        String       @unique @db.VarChar(255)
  passwordHash String       @db.VarChar(255)
  isAdmin         Boolean      @default(false) @map("is_admin")
  isBanned        Boolean      @default(false) @map("is_banned")
  emailVerifiedAt DateTime?    @map("email_verified_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  discussions     Discussion[]
  posts           Post[]
  sessions        Session[]
  emailTokens     EmailToken[]
  notifications   Notification[] @relation("penerima")
  notifikasiDibuat Notification[] @relation("pelaku")
  likes           Like[]

  @@map("users")
}

/// Notifikasi in-app: "X membalas diskusimu Y". Dibaca = readAt terisi.
model Notification {
  id           Int        @id @default(autoincrement())
  userId       Int        @map("user_id")
  user         User       @relation("penerima", fields: [userId], references: [id], onDelete: Cascade)
  actorId      Int        @map("actor_id")
  actor        User       @relation("pelaku", fields: [actorId], references: [id], onDelete: Cascade)
  discussionId Int        @map("discussion_id")
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  postNumber   Int        @map("post_number")
  readAt       DateTime?  @map("read_at")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@map("notifications")
}

/// Token sekali-pakai untuk verifikasi email dan reset password.
/// Yang disimpan hanya hash SHA-256; token mentah cuma ada di tautan email.
model EmailToken {
  id        Int       @id @default(autoincrement())
  userId    Int       @map("user_id")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  kind      String    @db.VarChar(20)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId])
  @@map("email_tokens")
}

model Session {
  id        String   @id @db.VarChar(64)
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

model Discussion {
  id         Int             @id @default(autoincrement())
  userId     Int             @map("user_id")
  user       User            @relation(fields: [userId], references: [id])
  title      String          @db.VarChar(200)
  isPinned   Boolean         @default(false) @map("is_pinned")
  isHidden   Boolean         @default(false) @map("is_hidden")
  createdAt  DateTime        @default(now()) @map("created_at")
  lastPostAt DateTime        @default(now()) @map("last_post_at")
  posts      Post[]
  notifications Notification[]
  likes      Like[]

  @@index([lastPostAt])
  @@map("discussions")
}

/// Suka per diskusi. Satu akun hanya bisa menyukai satu diskusi sekali;
/// menekan lagi berarti membatalkan suka.
model Like {
  id           Int        @id @default(autoincrement())
  discussionId Int        @map("discussion_id")
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  userId       Int        @map("user_id")
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now()) @map("created_at")

  @@unique([discussionId, userId])
  @@index([userId])
  @@map("likes")
}

model Post {
  id           Int        @id @default(autoincrement())
  discussionId Int        @map("discussion_id")
  discussion   Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  userId       Int        @map("user_id")
  user         User       @relation(fields: [userId], references: [id])
  number       Int
  content      String     @db.Text
  isHidden     Boolean    @default(false) @map("is_hidden")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@unique([discussionId, number])
  @@index([userId])
  @@map("posts")
}
